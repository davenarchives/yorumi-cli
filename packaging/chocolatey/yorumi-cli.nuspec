<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>yorumi-cli</id>
    <version>0.1.3</version>
    <title>Yorumi CLI</title>
    <authors>Daven Austhine Sumagang</authors>
    <owners>davenarchives</owners>
    <projectUrl>https://github.com/davenarchives/yorumi-cli</projectUrl>
    <packageSourceUrl>https://github.com/davenarchives/yorumi-cli</packageSourceUrl>
    <licenseUrl>https://github.com/davenarchives/yorumi-cli/blob/main/LICENSE</licenseUrl>
    <projectSourceUrl>https://github.com/davenarchives/yorumi-cli</projectSourceUrl>
    <docsUrl>https://davenarchives.github.io/yorumi-cli/docs.html</docsUrl>
    <bugTrackerUrl>https://github.com/davenarchives/yorumi-cli/issues</bugTrackerUrl>
    <tags>yorumi anime cli mpv ffmpeg terminal downloader</tags>
    <summary>Terminal anime watcher and downloader powered by Yorumi and mpv.</summary>
    <description>
Yorumi CLI searches Yorumi, resolves anime episodes, opens playback in mpv, and can download Windows-friendly MP4 files with AAC audio.

This Chocolatey package runs the official Yorumi CLI Windows installer. The installer sets up a private Node.js runtime when needed, installs fzf, and configures the yorumi-cli command.

Runtime tools:
- mpv is used for playback.
- ffmpeg is used for downloads.
    </description>
    <releaseNotes>https://github.com/davenarchives/yorumi-cli/releases/tag/v0.1.3</releaseNotes>
    <dependencies>
      <dependency id="chocolatey" version="2.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
