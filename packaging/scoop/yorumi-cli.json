{
  "version": "0.1.1",
  "description": "Terminal anime watcher and downloader powered by Yorumi and mpv.",
  "homepage": "https://github.com/davenarchives/yorumi-cli",
  "license": "MIT",
  "url": "https://github.com/davenarchives/yorumi-cli/archive/refs/tags/v0.1.1.zip",
  "hash": "44bbfa5ed3d606c33311969fafdcdce67f7dd0cdc43716a1da93abeed51bdf3e",
  "extract_dir": "yorumi-cli-0.1.1",
  "depends": "nodejs",
  "bin": "yorumi-cli.cmd",
  "post_install": [
    "npm install --loglevel=error",
    "$node = (Get-Command node).Source",
    "$launcher = Join-Path $dir 'bin\\yorumi-cli.cjs'",
    "Set-Content -Path (Join-Path $dir 'yorumi-cli.cmd') -Encoding ASCII -Value ('@echo off' + [Environment]::NewLine + '\"' + $node + '\" \"' + $launcher + '\" %*' + [Environment]::NewLine)"
  ],
  "notes": [
    "Yorumi CLI uses mpv for playback and ffmpeg for downloads.",
    "Install them with: scoop install mpv ffmpeg",
    "Run: yorumi-cli --help"
  ],
  "checkver": {
    "github": "https://github.com/davenarchives/yorumi-cli"
  },
  "autoupdate": {
    "url": "https://github.com/davenarchives/yorumi-cli/archive/refs/tags/v$version.zip",
    "extract_dir": "yorumi-cli-$version"
  }
}
